# Set secrets locally, never commit the resulting .env.
INFRADECK_DATABASE_URL=postgresql://infradeck:local-only@localhost:25432/infradeck
INFRADECK_ORIGIN=http://localhost:5187
INFRADECK_PRODUCTION=false
INFRADECK_KEK_FILE=.runtime/kek
INFRADECK_RSA_FILE=.runtime/rsa.pem
INFRADECK_OTP_KEY_FILE=.runtime/otp
INFRADECK_TELEGRAM_TOKEN=123456789:replace-with-own-bot-token
INFRADECK_TELEGRAM_USERNAME=replace_with_own_bot
INFRADECK_TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
INFRADECK_TELEGRAM_PROXY=
INFRADECK_PRIVATE_CIDRS=
