  "components": {
    "schemas": {
      "AuthState": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "enrollment",
              "otp",
              "authenticated"
            ],
            "title": "State"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "telegram_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Telegram Url"
          },
          "recovery_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recovery Codes"
          }
        },
        "type": "object",
        "required": [
          "state"
        ],
        "title": "AuthState"
      },
      "CheckRequest": {
        "properties": {
          "jwe": {
            "type": "string",
            "maxLength": 60000,
            "minLength": 100,
            "title": "Jwe"
          },
          "server_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Server Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "jwe"
        ],
        "title": "CheckRequest"
      },
      "CheckResult": {
        "properties": {
          "proof": {
            "type": "string",
            "title": "Proof"
          },
          "fingerprint": {
            "type": "string",
            "title": "Fingerprint"
          },
          "expires_at": {
            "type": "number",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "proof",
          "fingerprint",
          "expires_at"
        ],
        "title": "CheckResult"
      },
      "Code": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{8}$",
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "Code"
      },
      "EncryptionKey": {
        "properties": {
          "key": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Key"
          },
          "nonce": {
            "type": "string",
            "title": "Nonce"
          },
          "expires_at": {
            "type": "number",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "key",
          "nonce",
          "expires_at"
        ],
        "title": "EncryptionKey"
      },
      "Fingerprint": {
        "properties": {
          "fingerprint": {
            "type": "string",
            "title": "Fingerprint"
          }
        },
        "type": "object",
        "required": [
          "fingerprint"
        ],
        "title": "Fingerprint"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "login": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "title": "Login"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "title": "Login"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "login": {
            "type": "string",
            "title": "Login"
          }
        },
        "type": "object",
        "required": [
          "id",
          "login"
        ],
        "title": "Me"
      },
      "Probe": {
        "properties": {
          "host": {
